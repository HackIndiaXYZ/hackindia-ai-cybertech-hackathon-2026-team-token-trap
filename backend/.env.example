# TokenTrap Backend Configuration
APP_NAME=TokenTrap API
APP_VERSION=1.0.0
ENVIRONMENT=development

# JWT Secrets (Minimum 32 characters recommended for HMAC SHA-256)
# Generate securely with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GENUINE_JWT_SECRET=replace_with_genuine_jwt_secret_32_bytes_min
DECOY_JWT_SECRET=replace_with_decoy_jwt_secret_32_bytes_min

GENUINE_JWT_ISSUER=tokentrap-auth
GENUINE_JWT_AUDIENCE=tokentrap-admin

DECOY_JWT_ISSUER=tokentrap-deception
DECOY_JWT_AUDIENCE=tokentrap-decoy

# Genuine administrator account
# Generate password hash with: python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('YourSecurePassword'))"
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$...

# Separate decoy account
DECOY_EMAIL=visitor@gmail.com
DECOY_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$...
